DRY_RUN=true
# Optional simulated balance for offline demos. Defaults to zero.
DRY_RUN_WALLET_BALANCE_KOBO=0
DATABASE_PATH=./data/rein.db
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_SOURCE_ACCOUNT=
MONNIFY_SENDER_NAME=Rein Demo Business
MONNIFY_SENDER_BANK_CODE=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Process-bound agent (MCP). Must be a registered principal.
AGENT_ID=demo-ops-agent
# Shared secret for AGENT_ID — must match that agent's entry in AGENT_TOKENS.
AGENT_TOKEN=rein-demo-ops-token
# agentId:token pairs. Tokens are the only way to assume a principal.
AGENT_TOKENS=demo-ops-agent:rein-demo-ops-token,demo-readonly-agent:rein-demo-readonly-token
# Human approver secret for POST /api/approvals/*/approve|deny
APPROVER_TOKEN=rein-demo-approver-token
HTTP_PORT=8787
# Defaults to MONNIFY_SECRET_KEY when empty.
WEBHOOK_SECRET=
