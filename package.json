{
  "name": "rein",
  "version": "1.0.0",
  "description": "A deterministic permission firewall for AI-driven Monnify payments.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx src/agent/demo.ts",
    "api": "tsx src/http/server.ts",
    "web": "npm run build:web && tsx src/http/server.ts",
    "web:dev": "vite --host",
    "mcp": "tsx src/mcp/server.ts",
    "test": "vitest run test"
  },
  "keywords": [
    "mcp",
    "monnify",
    "payments",
    "ai-safety"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "@fastify/static": "^10.1.0",
    "@fontsource/varela-round": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-raw-body": "^5.0.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
